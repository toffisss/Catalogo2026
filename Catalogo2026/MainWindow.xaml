<Window x:Class="Catalogo2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Catalogo2026"
        mc:Ignorable="d"
        Title="Catálogo de Juegos" Height="640" Width="1040"
        MinHeight="560" MinWidth="900" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ===== Colores del tema (se cambian desde Configuración) ===== -->
        <SolidColorBrush x:Key="FondoBrush"      Color="#171A21"/>
        <SolidColorBrush x:Key="PanelBrush"      Color="#1B2838"/>
        <SolidColorBrush x:Key="TarjetaBrush"    Color="#22344A"/>
        <SolidColorBrush x:Key="TextoBrush"      Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextoSuaveBrush" Color="#8F98A0"/>
        <SolidColorBrush x:Key="BordeBrush"      Color="#2A3F5A"/>
        <SolidColorBrush x:Key="AcentoBrush"     Color="#1A9FFF"/>
        <SolidColorBrush x:Key="HoverBrush"      Color="#2A475E"/>

        <!-- Botones de navegación (menú superior y lateral) -->
        <Style x:Key="NavBoton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextoBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de acción principal (azul) -->
        <Style x:Key="BotonAcento" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AcentoBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Título de cada sección -->
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoBrush}"/>
        </Style>
        <Style x:Key="SubtituloSeccion" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,18"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoSuaveBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Tarjeta de juego con portada (Destacados y Tienda) -->
        <DataTemplate x:Key="TarjetaJuego">
            <Border Width="170" Margin="0,0,16,16" CornerRadius="8"
                    Background="{DynamicResource TarjetaBrush}">
                <StackPanel>
                    <Grid Height="150">
                        <Border Background="{Binding ColorFondo}" CornerRadius="8,8,0,0">
                            <TextBlock Text="{Binding Inicial}" FontSize="56" FontWeight="Bold"
                                       Foreground="White" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Imagen}" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel Margin="10,8,10,10">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextoBrush}"/>
                        <TextBlock Text="{Binding Genero}" FontSize="11" Margin="0,2,0,8"
                                   Foreground="{DynamicResource TextoSuaveBrush}"/>
                        <DockPanel>
                            <TextBlock Text="{Binding Precio}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AcentoBrush}"/>
                            <Button Content="{Binding TextoBoton}" Tag="{Binding}" Click="TarjetaBoton_Click"
                                    Style="{StaticResource BotonAcento}" HorizontalAlignment="Right"
                                    Padding="8,4" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource FondoBrush}" TextElement.Foreground="{DynamicResource TextoBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Cabecera -->
            <RowDefinition Height="*"/>      <!-- Menú lateral + contenido -->
            <RowDefinition Height="Auto"/>   <!-- Barra de estado -->
        </Grid.RowDefinitions>

        <!-- ================= CABECERA ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BordeBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="🎮 CATÁLOGO" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,30,0"/>

                <!-- Menú superior -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="btnTienda"    Content="TIENDA"    Tag="Tienda"    Style="{StaticResource NavBoton}" Click="Navegar_Click"/>
                    <Button x:Name="btnComunidad" Content="COMUNIDAD" Tag="Comunidad" Style="{StaticResource NavBoton}" Click="Navegar_Click"/>
                    <Button x:Name="btnSoporte"   Content="SOPORTE"   Tag="Soporte"   Style="{StaticResource NavBoton}" Click="Navegar_Click"/>
                </StackPanel>

                <!-- Zona derecha: carrito, mi perfil y cerrar sesión -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="txtCarrito" Text="🛒 0" VerticalAlignment="Center" Margin="0,0,14,0"
                               FontWeight="SemiBold" ToolTip="Artículos en el carrito"/>
                    <Button x:Name="btnPerfil" Content="👤 mi perfil" Tag="Perfil"
                            Style="{StaticResource NavBoton}" Click="Navegar_Click" Margin="0,0,10,0"/>
                    <Button Content="Cerrar Sesión" Style="{StaticResource BotonAcento}" Click="BtnCerrarSesion_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= CUERPO ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BordeBrush}" BorderThickness="0,0,1,0" Padding="12,18">
                <StackPanel>
                    <TextBlock Text="BIBLIOTECA" FontSize="11" FontWeight="Bold" Margin="14,0,0,8"
                               Foreground="{DynamicResource TextoSuaveBrush}"/>
                    <Button x:Name="btnDestacados"    Content="⭐  Destacados"    Tag="Destacados"    Style="{StaticResource NavBoton}" Click="Navegar_Click" Margin="0,0,0,4"/>
                    <Button x:Name="btnMisJuegos"     Content="🎮  Mis juegos"    Tag="MisJuegos"     Style="{StaticResource NavBoton}" Click="Navegar_Click" Margin="0,0,0,4"/>
                    <Button x:Name="btnConfiguracion" Content="⚙  Configuración" Tag="Configuracion" Style="{StaticResource NavBoton}" Click="Navegar_Click"/>
                </StackPanel>
            </Border>

            <!-- Contenido: solo se ve un panel a la vez -->
            <Grid Grid.Column="1" Margin="28,22,20,10">

                <!-- ===== DESTACADOS ===== -->
                <ScrollViewer x:Name="panelDestacados" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Destacados" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock Text="Lo más destacado de la semana." Style="{StaticResource SubtituloSeccion}"/>

                        <!-- CARRUSEL: va cambiando de imagen al azar cada pocos segundos -->
                        <Border CornerRadius="10" Height="280" Margin="0,0,16,24" ClipToBounds="True"
                                Background="{DynamicResource TarjetaBrush}">
                            <Grid>
                                <Image x:Name="imgCarrusel" Stretch="UniformToFill"/>

                                <!-- Degradado inferior para que se lea el texto -->
                                <Border VerticalAlignment="Bottom" Height="110">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,18">
                                    <TextBlock Text="JUEGO DESTACADO" FontSize="11" FontWeight="Bold" Foreground="#9FD4FF"/>
                                    <TextBlock x:Name="txtCarruselTitulo" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="Ver en la tienda" Tag="Tienda" Click="Navegar_Click"
                                                Style="{StaticResource BotonAcento}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="txtCarruselPosicion" Foreground="White" Opacity="0.8"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Flechas anterior / siguiente -->
                                <Button Content="‹" Click="CarruselAnterior_Click" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="10,0,0,0" Width="40" Height="40"
                                        FontSize="22" Style="{StaticResource BotonAcento}" Opacity="0.85" ToolTip="Anterior"/>
                                <Button Content="›" Click="CarruselSiguiente_Click" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,10,0" Width="40" Height="40"
                                        FontSize="22" Style="{StaticResource BotonAcento}" Opacity="0.85" ToolTip="Siguiente"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Más populares" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="icDestacados" ItemTemplate="{StaticResource TarjetaJuego}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== MIS JUEGOS ===== -->
                <ScrollViewer x:Name="panelMisJuegos" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Mis juegos" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock x:Name="txtResumenBiblioteca" Style="{StaticResource SubtituloSeccion}"/>
                        <ItemsControl x:Name="icMisJuegos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="8"
                                            Background="{DynamicResource TarjetaBrush}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6"
                                                    Background="{Binding ColorFondo}" Margin="0,0,14,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Inicial}" FontSize="24" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Imagen}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="▶ Jugar" Tag="{Binding}"
                                                    Click="Jugar_Click" Style="{StaticResource BotonAcento}" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextoBrush}"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextoSuaveBrush}">
                                                    <Run Text="{Binding Genero, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Horas, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== CONFIGURACIÓN ===== -->
                <ScrollViewer x:Name="panelConfiguracion" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Configuración" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock Text="Personaliza la aplicación a tu gusto." Style="{StaticResource SubtituloSeccion}"/>

                        <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="chkTemaOscuro" Content="Tema oscuro"
                                          Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,14"
                                          Checked="TemaOscuro_Changed" Unchecked="TemaOscuro_Changed"/>

                                <TextBlock Text="Idioma" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cbIdioma" SelectedIndex="0" Margin="0,0,0,14" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Español"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Català"/>
                                </ComboBox>

                                <CheckBox x:Name="chkNotificaciones" Content="Recibir notificaciones de ofertas" IsChecked="True"
                                          Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,14"/>

                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
                                    <Run Text="Volumen: "/>
                                    <Run Text="{Binding ElementName=sldVolumen, Path=Value, Mode=OneWay, StringFormat='{}{0:0} %'}"/>
                                </TextBlock>
                                <Slider x:Name="sldVolumen" Minimum="0" Maximum="100" Value="70" Width="260"
                                        HorizontalAlignment="Left" Margin="0,0,0,18"/>

                                <Button Content="Guardar cambios" Style="{StaticResource BotonAcento}"
                                        HorizontalAlignment="Left" Click="GuardarConfiguracion_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== TIENDA ===== -->
                <ScrollViewer x:Name="panelTienda" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Tienda" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock Text="Ofertas y novedades. Añade juegos al carrito." Style="{StaticResource SubtituloSeccion}"/>
                        <ItemsControl x:Name="icTienda" ItemTemplate="{StaticResource TarjetaJuego}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== COMUNIDAD ===== -->
                <ScrollViewer x:Name="panelComunidad" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Comunidad" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock Text="Comparte novedades con el resto de jugadores." Style="{StaticResource SubtituloSeccion}"/>

                        <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Publicar" Style="{StaticResource BotonAcento}"
                                        Margin="10,0,0,0" Click="Publicar_Click"/>
                                <TextBox x:Name="txtNuevaPublicacion" Padding="6" VerticalContentAlignment="Center"
                                         ToolTip="Escribe tu mensaje"/>
                            </DockPanel>
                        </Border>

                        <ItemsControl x:Name="icPublicaciones">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8"
                                            Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextoSuaveBrush}">
                                                <Run Text="{Binding Autor, Mode=OneWay}" FontWeight="Bold"
                                                     Foreground="{DynamicResource AcentoBrush}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Hace, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextoBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== SOPORTE ===== -->
                <ScrollViewer x:Name="panelSoporte" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Soporte" Style="{StaticResource TituloSeccion}"/>
                        <TextBlock Text="Preguntas frecuentes y contacto con el equipo de ayuda." Style="{StaticResource SubtituloSeccion}"/>

                        <Expander Header="¿Cómo descargo un juego que he comprado?" Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8">
                            <TextBlock Text="Ve a «Mis juegos» y pulsa «Jugar»: la descarga empieza automáticamente."
                                       TextWrapping="Wrap" Margin="22,6,0,6" Foreground="{DynamicResource TextoSuaveBrush}"/>
                        </Expander>
                        <Expander Header="¿Puedo devolver un juego?" Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,8">
                            <TextBlock Text="Sí, en los 14 días siguientes a la compra si lo has jugado menos de 2 horas."
                                       TextWrapping="Wrap" Margin="22,6,0,6" Foreground="{DynamicResource TextoSuaveBrush}"/>
                        </Expander>
                        <Expander Header="He olvidado mi contraseña" Foreground="{DynamicResource TextoBrush}" Margin="0,0,0,18">
                            <TextBlock Text="Contacta con soporte con el formulario de abajo indicando tu nombre de usuario."
                                       TextWrapping="Wrap" Margin="22,6,0,6" Foreground="{DynamicResource TextoSuaveBrush}"/>
                        </Expander>

                        <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Abrir una consulta" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Asunto" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cbAsunto" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Problema con una compra"/>
                                    <ComboBoxItem Content="Problema técnico"/>
                                    <ComboBoxItem Content="Mi cuenta"/>
                                    <ComboBoxItem Content="Otro"/>
                                </ComboBox>
                                <TextBlock Text="Mensaje" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtMensajeSoporte" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Enviar consulta" Style="{StaticResource BotonAcento}" Click="EnviarSoporte_Click"/>
                                    <TextBlock x:Name="txtSoporteResultado" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== PERFIL ===== -->
                <ScrollViewer x:Name="panelPerfil" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="10" Padding="22">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="96" Height="96" CornerRadius="48"
                                        Background="{DynamicResource AcentoBrush}" Margin="0,0,22,0">
                                    <TextBlock x:Name="txtPerfilInicial" FontSize="44" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPerfilNombre" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtPerfilMiembro" Foreground="{DynamicResource TextoSuaveBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="🟢 En línea" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock x:Name="txtStatJuegos" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AcentoBrush}"/>
                                    <TextBlock Text="Juegos" Foreground="{DynamicResource TextoSuaveBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock x:Name="txtStatHoras" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AcentoBrush}"/>
                                    <TextBlock Text="Horas jugadas" Foreground="{DynamicResource TextoSuaveBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource TarjetaBrush}" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="12" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AcentoBrush}"/>
                                    <TextBlock Text="Logros" Foreground="{DynamicResource TextoSuaveBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Button Content="Editar perfil" Style="{StaticResource BotonAcento}" HorizontalAlignment="Left"
                                Click="EditarPerfil_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= BARRA DE ESTADO ================= -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BordeBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="txtEstado" Text="Bienvenido al catálogo." FontSize="12"
                       Foreground="{DynamicResource TextoSuaveBrush}"/>
        </Border>
    </Grid>
</Window>
