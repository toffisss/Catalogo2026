<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Todas las imágenes de la carpeta Imagenes se incluyen en la app
       (las usa el carrusel de la portada). Basta con copiar más ahí. -->
  <ItemGroup>
    <None Remove="Imagenes\**" />
    <Resource Include="Imagenes\*.jpg;Imagenes\*.jpeg;Imagenes\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.7.0" />
  </ItemGroup>

</Project>
