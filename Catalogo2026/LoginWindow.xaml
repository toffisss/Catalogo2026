<Window x:Class="Catalogo2026.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de Sesión" Height="540" Width="400" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Botones con su propio color: Windows ya no los pinta de azul claro al pasar el ratón -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="30" Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="CATÁLOGO DE JUEGOS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Usuario:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtUsuario" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Contraseña:" FontWeight="SemiBold"/>
            <!-- PasswordBox oculta automáticamente los caracteres cumpliendo el requisito -->
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,15" Padding="5"/>

            <!-- Etiqueta para los mensajes dinámicos de error o éxito -->
            <TextBlock x:Name="lblMensaje" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <Button x:Name="btnLogin" Content="Login" Padding="10" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click" Margin="0,0,0,10"/>
            <!-- Práctica 3: alta de usuarios en la tabla Usuarios de MySQL -->
            <Button x:Name="btnNuevoUsuario" Content="Nuevo usuario" Padding="10" Background="#E1E1E1" Click="BtnNuevoUsuario_Click" Margin="0,0,0,10"/>
            <Button x:Name="btnSalir" Content="Salir" Padding="10" Background="DarkGray" Click="BtnSalir_Click"/>

        </StackPanel>
    </Border>
</Window>