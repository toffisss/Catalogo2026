<Window x:Class="Catalogo2026.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de Sesión" Height="350" Width="400" WindowStartupLocation="CenterScreen">

    <Border Padding="30" Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="CATÁLOGO DE JUEGOS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Usuario:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtUsuario" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Contraseña:" FontWeight="SemiBold"/>
            <!-- PasswordBox oculta automáticamente los caracteres cumpliendo el requisito -->
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,15" Padding="5"/>

            <!-- Etiqueta para los mensajes dinámicos de error o éxito -->
            <TextBlock x:Name="lblMensaje" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <Button x:Name="btnLogin" Content="Login" Padding="10" Background="#0078D7" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click" Margin="0,0,0,10"/>
            <Button x:Name="btnSalir" Content="Salir" Padding="10" Background="DarkGray" Click="BtnSalir_Click"/>

        </StackPanel>
    </Border>
</Window>